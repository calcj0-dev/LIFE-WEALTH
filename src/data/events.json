{
  "_note": "マスで起きる出来事。design.md 5.1。金額は万円。size は small（小）・medium（中）・large（大）。when は起きる条件、weightBy は職業ごとの起きやすさ、choice は選ぶ出来事",
  "events": [
    { "id": "points", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": 1 }] },
    { "id": "flea", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": 2 }] },
    { "id": "prize", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": 3 }] },
    { "id": "eatOut", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": -1 }] },
    { "id": "phoneCrack", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": -2 }] },
    { "id": "ceremony", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": -3 }] },
    { "id": "trafficFine", "size": "small", "weight": 1, "effects": [{ "t": "cash", "amount": -1 }] },
    { "id": "lesson", "size": "small", "weight": 1, "when": { "hasChildren": true }, "effects": [{ "t": "cash", "amount": -2 }] },

    { "id": "bonus", "size": "medium", "weight": 1, "when": { "employed": true }, "effects": [{ "t": "cash", "amount": 20 }] },
    { "id": "gig", "size": "medium", "weight": 1, "effects": [{ "t": "cash", "amount": 10 }] },
    { "id": "refund", "size": "medium", "weight": 1, "effects": [{ "t": "cash", "amount": 10 }] },
    { "id": "appliance", "size": "medium", "weight": 1, "effects": [{ "t": "cash", "amount": -10 }] },
    { "id": "carRepair", "size": "medium", "weight": 1, "effects": [{ "t": "cash", "amount": -20 }] },
    { "id": "travel", "size": "medium", "weight": 1, "effects": [{ "t": "cash", "amount": -15 }] },
    { "id": "clinic", "size": "medium", "weight": 1, "effects": [{ "t": "cash", "amount": -5 }] },
    { "id": "homeRepair", "size": "medium", "weight": 1, "when": { "homeOwner": true }, "effects": [{ "t": "cash", "amount": -30 }] },
    { "id": "spousePart", "size": "medium", "weight": 1, "when": { "spouseWork": "none" }, "effects": [{ "t": "spousePart" }] },

    { "id": "promotion", "size": "large", "weight": 1, "when": { "employed": true, "promotable": true }, "effects": [{ "t": "salaryRate", "rate": 0.05 }] },
    { "id": "raise", "size": "large", "weight": 1, "when": { "employed": true, "stableIncome": true }, "effects": [{ "t": "salaryRate", "rate": 0.03 }] },
    { "id": "jobChange", "size": "large", "weight": 1, "choice": "jobChange" },
    {
      "id": "unemployment",
      "size": "large",
      "weight": 1,
      "weightBy": "unemployment",
      "when": { "employed": true },
      "effects": [{ "t": "noIncome", "months": 6 }, { "t": "salaryRate", "rate": -0.1 }]
    },
    { "id": "sickness", "size": "large", "weight": 1, "weightBy": "sickness", "effects": [{ "t": "sickness" }] },
    { "id": "care", "size": "large", "weight": 1, "when": { "minYear": 10 }, "effects": [{ "t": "cash", "amount": -100 }] },
    { "id": "disaster", "size": "large", "weight": 0.5, "when": { "homeOwner": true }, "effects": [{ "t": "disaster", "amount": 300 }] },
    { "id": "sideBusiness", "size": "large", "weight": 1, "when": { "sideBusiness": false }, "choice": "sideBusiness" },
    { "id": "parentsGift", "size": "large", "weight": 1, "when": { "maxYear": 10 }, "effects": [{ "t": "cash", "amount": 50 }] }
  ]
}
